{
  "name": "blackboard-calendar-sync",
  "version": "0.1.0",
  "description": "Mirror Blackboard due dates into Google Calendar, with an xbar menu bar status item",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth": "node dist/auth.js",
    "probe": "node dist/probe.js",
    "test-event": "node dist/test-event.js",
    "sync": "node dist/sync.js",
    "dry-run": "node dist/sync.js --dry-run",
    "install-xbar": "node dist/install-xbar.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jopersaud/blackboard-calendar-sync.git"
  },
  "bugs": {
    "url": "https://github.com/Jopersaud/blackboard-calendar-sync/issues"
  },
  "homepage": "https://github.com/Jopersaud/blackboard-calendar-sync#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "googleapis": "^182.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
